\documentclass[{{ font_size }}pt]{article}

\usepackage[margin=1in,top=1.45in,bottom=1.05in,headheight=64pt,headsep=.25in,footskip=.35in]{geometry}
\usepackage[T1]{fontenc}
\usepackage[rgb]{xcolor}
\usepackage{array, fancyhdr, graphicx, longtable, mathptmx, enumitem, needspace}

\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\setlength{\parindent}{0pt}
\setlength{\parskip}{10pt}
\setlength{\emergencystretch}{2em}
\raggedbottom

\newcommand{\usafletterhead}[1]{
    \textcolor[rgb]{0,.1,.7}{\textsf{\textbf{#1}}}\rm
}

\fancypagestyle{mfrfirstpage}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
{% if letterhead_logo %}
    \fancyhead[L]{\hspace*{-.5in}\raisebox{-0.08in}{\includegraphics[width=1in]{ {{ letterhead_logo }} }}}
{% else %}
    \fancyhead[L]{}
{% endif %}
    \fancyhead[C]{
        \usafletterhead{ {{ letterhead_line1 }}\\
            {{ letterhead_line2 }}\\
            {{ letterhead_line3 }}
    }}
}

\fancypagestyle{mfrcontinuation}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
    \renewcommand{\footrulewidth}{0pt}
    \fancyhead[R]{\raisebox{0.32in}{\scriptsize\thepage}}
}

\pagestyle{mfrcontinuation}

\newenvironment{usaflist}[1][] {
    \begin{enumerate}[label=\arabic*.,leftmargin=*,labelsep=.8em,itemsep=1em,topsep=1em,parsep=0pt,#1]
}{
    \end{enumerate}
}

\newcommand{\mfrtable}{
    \vspace{.5em}
    \begingroup
    \small
    \setlength{\tabcolsep}{3pt}
    \renewcommand{\arraystretch}{1.25}
    \begin{longtable}{|>{\raggedright\arraybackslash}p{.65in}|>{\raggedright\arraybackslash}p{1.1in}|>{\raggedright\arraybackslash}p{.9in}|>{\raggedright\arraybackslash}p{2.25in}|>{\raggedright\arraybackslash}p{.9in}|}
    \hline
    \textbf{Rank} & \textbf{Name} & \textbf{Status} & \textbf{Email} & \textbf{Phone} \\
    \hline
    \endfirsthead
    \hline
    \textbf{Rank} & \textbf{Name} & \textbf{Status} & \textbf{Email} & \textbf{Phone} \\
    \hline
    \endhead
{% for row in table_rows %}
    {{ row.rank }} & {{ row.name }} & {{ row.status }} & {{ row.email }} & {{ row.phone }} \\
    \hline
{% endfor %}
    \end{longtable}
    \endgroup
    \vspace{.5em}
}

\newcommand{\mfrsignature}{
    \Needspace{1.75in}
    \vspace{2\baselineskip}
    \noindent\hfill
    \begin{minipage}[t]{3.35in}
        {{ signer_name_rank }}\\
        {{ signer_duty_title }}\\
        {{ signer_unit }}
    \end{minipage}
}

\begin{document}
\thispagestyle{mfrfirstpage}

\hfill {{ memo_date }}

MEMORANDUM FOR~ {{ memo_for }}

FROM:~ {{ memo_from }}

SUBJECT:~ {{ subject }}

\begin{usaflist}

{% for p in paragraphs %}
\item {{ p }}
{% endfor %}

{% for b in bullets %}
\item {{ b }}

{% if loop.first and table_enabled %}
\mfrtable
{% endif %}

{% endfor %}

{% if poc_enabled %}
\item For questions or concerns, contact {{ poc_name }} at DSN: {{ poc_phone }} or via email at {{ poc_email }}.
{% endif %}

{% if supersedes_enabled %}
\item {{ supersedes_text }}
{% endif %}

{% if attachments_enabled %}
\item Attachments: {% for a in attachments %}{{ a }}{% if not loop.last %}; {% endif %}{% endfor %}
{% endif %}

\end{usaflist}

\mfrsignature

\end{document}
