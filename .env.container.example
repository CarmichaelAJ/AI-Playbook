NODE_ENV=production
PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3001

# Auth modes: disabled, mock-mil, entra
AUTH_PROVIDER=mock-mil
REQUIRE_MIL_EMAIL=true

# Entra mode values. Leave blank until tenant/app registration is approved.
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
MEDIA_STORAGE_DIR=/data/media

# Feature switches for platform modules.
FEATURE_ADMIN_CONSOLE=true
FEATURE_TOOL_SUBMISSIONS=true
FEATURE_COMMUNITY_SUBMISSIONS=true
FEATURE_PLATFORM_DISCOVERY_FEEDS=true
FEATURE_VOTING=true
FEATURE_COMMENTS=true
FEATURE_PERSONALIZED_LEARNING=true
FEATURE_ANALYTICS=true
FEATURE_MESSAGING=true
FEATURE_FIRST_PARTY_VIDEOS=true
FEATURE_AUTH=true
